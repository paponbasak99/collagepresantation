# DocBook Environment Variables Template
PORT=3000
NODE_ENV=production

# JWT Configuration (Change in production!)
JWT_SECRET=your_production_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite path or Postgres connection string)
DATABASE_URL=./data/docbook.db

# Clinic Configuration
CLINIC_NAME=DocBook Health Center
CLINIC_CITY=Dhaka
CLINIC_PHONE=+8801700000000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Reservation Hold Window (in minutes)
SLOT_HOLD_MINUTES=5

# Medical Data Encryption Key (Must be at least 32 characters for AES-256 in production!)
ENCRYPTION_KEY=replace_with_a_secure_32_character_aes_encryption_key_here!
